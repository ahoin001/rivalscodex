# Copy to `.env` and fill in values. See also `docs/predictability.md` (draft preview, publish freshness, flags).

# --- Supabase (browser + server) ---
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; legacy anon key name also supported in code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Turn on Supabase-backed editorial UI and reads.
NEXT_PUBLIC_ENABLE_SUPABASE=true

# Development: set to "false" to require profiles.is_guide_editor even locally (default: any signed-in user may edit guides in dev).
# NEXT_PUBLIC_ALLOW_DEV_GUIDE_EDIT=

# Guide editing: `personal` (default) = inline edit on hero pages, auto-save published, no login.
# Set to `admin` when sharing publicly — auth-gated /admin/guides, hide inline editor.
# NEXT_PUBLIC_GUIDE_EDIT_POLICY=personal

# Server-only: roster snapshot sync + privileged guide writes in personal mode (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set "false" to always hit the Marvel API first (when snapshot exists but you want live fetches).
SUPABASE_USE_ROSTER_SNAPSHOT=

# Roster snapshot row `fetched_at` max age before `readStrictRosterSnapshotHeroes` ignores it (seconds, default 3600).
ROSTER_SNAPSHOT_MAX_AGE_SECONDS=3600

# POST /api/sync/roster-snapshot — send header: Authorization: Bearer <secret>
ROSTER_SNAPSHOT_SYNC_SECRET=

# --- Marvel Rivals API (snapshot sync + live roster) ---
MARVEL_RIVALS_API_KEY=
# MARVEL_RIVALS_API_BASE_URL=https://marvelrivalsapi.com/api/v1

# --- Optional integrations ---
# YOUTUBE_API_KEY=
# NEXT_PUBLIC_ENABLE_EXTERNAL_APIS=true
# NEXT_PUBLIC_PREFER_API_CONTENT=true
# NEXT_PUBLIC_ENABLE_DEV_ADMIN_UI=true
