{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm run start -- --port=4173",
      "startServerReadyPattern": "Ready",
      "settings": {
        "preset": "desktop"
      },
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/heroes/captain-america"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2800
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    }
  }
}
